# JustAnotherPanel (JAP) Credentials
JAP_API_KEY=YOUR_JAP_API_KEY_HERE
JAP_API_URL=https://justanotherpanel.com/api/v2

# X (Twitter) Target Account Configuration
# Put the USERNAME ONLY - no @ symbol, no full URL
# The account MUST be PUBLIC (private accounts cannot be tracked)
TARGET_X_USERNAME=elonmusk
POLL_INTERVAL_SECONDS=3.0

# Set USE_TWEET_URL=true if your JAP service boosts Tweet Views, Likes, Retweets
# (the bot will send the tweet's own URL as the order link)
# Set USE_TWEET_URL=false if your service boosts something inside the tweet (Instagram post, YouTube video, etc.)
USE_TWEET_URL=false

# Default Order Parameters
DEFAULT_SERVICE_ID=1234
DEFAULT_QUANTITY=1000

# Optional Domain to Service ID Mappings (JSON format)
# Maps different platforms to different JAP Service IDs
SERVICE_MAPPING_JSON={"instagram.com": 1234, "tiktok.com": 2345, "youtube.com": 3456, "x.com": 4567, "twitter.com": 4567}

# Nitter RSS Mirror Instances (comma-separated, NO spaces)
# IMPORTANT: Make sure each URL starts with https:// (not https//)
NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org,https://privacydev.net,https://nitter.privacydev.net,https://nitter.hu,https://nitter.1d4.us,https://nitter.kavin.rocks,https://nitter.unixfox.eu,https://n.sneed.eu,https://nitter.moomoo.me,https://nitter.cz

# Optional: Twikit fallback engine (more reliable when Nitter mirrors are all rate-limited)
# Add your X/Twitter account credentials here to enable Twikit as a backup tracker
# Leave blank to use Nitter-only mode
X_USERNAME=
X_EMAIL=
X_PASSWORD=
